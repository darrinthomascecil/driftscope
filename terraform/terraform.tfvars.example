# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (deployment-specific).
subscription_id = "00000000-0000-0000-0000-000000000000"
acr_name         = "driftscopeacr12345"   # globally unique, alphanumeric only
key_vault_name   = "driftscope-kv-12345"  # globally unique
gateway_dns_label = "driftscope-gw-12345" # -> driftscope-gw-12345.<region>.cloudapp.azure.com (unique per region)

# GitHub repo the Actions pipelines run from -> the deploy identity's OIDC federated credential.
github_repo = "your-org/driftscope"
# OPTIONAL: immutable numeric-id form (survives an owner/repo rename). Find the ids via:
#   gh api users/<owner> -q .id   and   gh api repos/<owner>/<repo> -q .id
# github_repo_ids = "your-org@1234567/driftscope@89012345"

# OPTIONAL: shared GitHub App signing key vault -> private-repo scanning. Set to the Key Vault
# holding your App's `gh-app-key` (may be an existing shared vault); the app identity is granted
# Crypto User on it, and deploy/overlays/cloud/config.env carries the App id/installation. Omit for
# public-repo-only.
# github_app_key_vault_name = "my-shared-kv"
# github_app_key_vault_rg   = "my-shared-rg"

# OPTIONAL custom domain. OMIT to run on Front Door's default *.azurefd.net hostname
# (no domain ownership / DNS delegation needed -- the app URL is a terraform output).
# base_domain = "example.com"              # -> app at driftscope.example.com (+ Azure DNS zone)

# Terraform CREATES the Entra access group; add yourself so you can log in:
admin_members = ["you@your-tenant.onmicrosoft.com"]

# Optional (defaults shown):
# tenant_id          = null            # defaults to your current az login tenant
# name_prefix        = "driftscope"
# location           = "eastus"
# node_vm_size       = "Standard_B4ms"
# node_count         = 1               # >=2 for HA + rollout headroom
# istio_revision     = "asm-1-29"
# kubernetes_version = null            # null => AKS default; pin for reproducibility
# allowed_group_name = "driftscope"
