# Copy to terraform.tfvars (gitignored). The shared layer: ACR + DNS zone, applied once.
subscription_id = "00000000-0000-0000-0000-000000000000"
acr_name        = "driftscopeacr12345"   # globally unique, alphanumeric -- the ONE registry
