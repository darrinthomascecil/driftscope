# GENERATED by terraform (terraform/edge.tf). Do not hand-edit; change terraform.tfvars and
# `terraform apply`. See deploy/overlays/cloud/edge/README.md for apply order + prerequisites.
%{ if enabled ~}
# The origin certificate. cert-manager issues a cert for ${origin_host} via the DNS-01
# ClusterIssuer and stores it in secret `driftscope-origin-tls` IN THE GATEWAY'S NAMESPACE
# (aks-istio-ingress) -- that's where Istio reads `credentialName` secrets from, regardless of
# where the Gateway resource lives. The Gateway :443 server serves it (see istio-routing.yaml).
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: driftscope-origin
  namespace: aks-istio-ingress
spec:
  secretName: driftscope-origin-tls
  duration: 2160h    # 90d
  renewBefore: 720h  # renew 30d out -- DNS-01, so renewal is unattended
  privateKey:
    rotationPolicy: Always
  dnsNames:
    - ${origin_host}
  issuerRef:
    name: letsencrypt-dns
    kind: ClusterIssuer
%{ else ~}
# DEMO MODE (no base_domain): leg 2 is HTTP, so there is no origin certificate. Set base_domain
# and re-apply to enable it. Do NOT `kubectl apply` this file in demo mode -- it has no object.
%{ endif ~}
