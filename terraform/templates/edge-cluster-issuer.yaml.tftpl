# GENERATED by terraform (terraform/edge.tf). Do not hand-edit; change terraform.tfvars and
# `terraform apply`. See deploy/overlays/cloud/edge/README.md for apply order + prerequisites.
%{ if enabled ~}
# Let's Encrypt DNS-01 issuer for the ORIGIN certificate. cert-manager proves control of
# ${zone_name} by writing _acme-challenge TXT records via the managed identity below
# (Workload Identity -- no client secret). Then it issues the cert Front Door validates on leg 2.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-dns
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
%{ if email != "" ~}
    email: ${email}
%{ endif ~}
    privateKeySecretRef:
      name: letsencrypt-dns-account-key
    solvers:
      - dns01:
          azureDNS:
            hostedZoneName: ${zone_name}
            resourceGroupName: ${resource_group}
            subscriptionID: ${subscription_id}
            environment: AzurePublicCloud
            managedIdentity:
              clientID: ${client_id}
%{ else ~}
# DEMO MODE (no base_domain): Front Door reaches the origin over HTTP, so no origin certificate
# is issued and there is nothing to do here. Set base_domain and re-apply to enable DNS-01.
# Do NOT `kubectl apply` this file in demo mode -- it has no object.
%{ endif ~}
