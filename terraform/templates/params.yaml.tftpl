# DEPLOYMENT PARAMETERS -- GENERATED by terraform (terraform/params.tf). Do not hand-edit;
# change terraform.tfvars and `terraform apply`. See deploy/overlays/cloud/oauth2-proxy.yaml
# for how these are consumed (atomic values + $(VAR) runtime composition).
apiVersion: v1
kind: ConfigMap
metadata:
  name: driftscope-params
  namespace: driftscope
data:
  HOST: "${host}"
  TENANT_ID: "${tenant_id}"
  ALLOWED_GROUP_ID: "${allowed_group_id}"
  ALLOWED_GROUP_NAME: "${allowed_group_name}"
  # Front Door edge (0.4b): the origin FQDN cert-manager issues a cert for, and the Front Door
  # GUID the gateway validates (X-Azure-FDID) to reject non-Front-Door traffic.
  ORIGIN_FQDN: "${origin_fqdn}"
  FRONTDOOR_ID: "${frontdoor_id}"
