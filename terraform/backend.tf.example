# REMOTE Terraform state (DEFAULT). `make up` -> `make state` provisions the Azure Storage backend
# and GENERATES `backend.tf` (a copy of this file) + `backend.hcl`, so you normally never touch
# this by hand. It is kept as an .example (and backend.tf is git-ignored) so a bare `terraform`
# invocation with no generated backend.tf still defaults to LOCAL state.
#
#   make up                       # default: provisions the backend, inits remote, applies
#   LOCAL_STATE=1 make up         # opt out: local state (throwaway demo only)
#   make state-migrate            # one-time: move an existing LOCAL state up into the backend
#
# Config lives in backend.hcl (git-ignored) so this file carries no account-specific values.
# Keyless: use_azuread_auth = true -- no storage account keys in config or state.
# See docs/remote-state.md.
terraform {
  backend "azurerm" {}
}
