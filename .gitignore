__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
tutorials/

# Generated scan reports. Regenerate with `driftscope scan`; the goldens under
# tests/golden/ are the committed, asserted-against copies.
drift-*.html
drift-*.md
drift-*.json
.playwright-mcp/

# Terraform. State is SENSITIVE (it stores the Entra client secret value + other secrets)
# and MUST NOT be committed; tfvars is deployment-specific (subscription id, admin UPNs).
# The provider lock file (.terraform.lock.hcl) is intentionally NOT ignored -- commit it
# for reproducible provider versions.
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform/terraform.tfvars
crash.log
crash.*.log
# Remote-state opt-in: the active backend config is per-deployment (keep the .example committed).
terraform/backend.tf
terraform/backend.hcl
