# prod AKS config. Shared GitHub App (same id/installation as every env); the App key
# lives in PROD's own Key Vault, reached via the prod UAMI. Fill the placeholders.
AZURE_TENANT_ID=<TENANT_ID>
GITHUB_APP_ID=4425305
GITHUB_APP_INSTALLATION_ID=149853299
GITHUB_APP_KEY_VAULT_URI=https://<PROD_KEYVAULT_NAME>.vault.azure.net
GITHUB_APP_KEY_NAME=gh-app-key
