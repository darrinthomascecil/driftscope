# Config for the local kind bootstrap (scripts/bootstrap/kind-up.sh / `make kind-up`).
# Copy to kind.env (gitignored) and fill in YOUR values. NEVER commit real values.

# --- required ---
HOST=driftscope.local.test     # local hostname you'll resolve to the gateway (your choice; not committed)
TENANT_ID=                     # your Entra (Azure AD) tenant id
CLIENT_ID=                     # the SSO Entra app (client) id, e.g. driftscope-kind-sso
ALLOWED_GROUP_ID=              # Entra security-group object id allowed to sign in
OAUTH2_CLIENT_SECRET=          # the Entra app client-secret VALUE (the password, NOT the keyId)

# --- optional (defaults shown) ---
# CTX=kind-driftscope-wi
# ISTIO_VERSION=1.29.5
# CERT_MANAGER_VERSION=v1.16.2
# METALLB_VERSION=v0.14.9
# METALLB_POOL=172.18.255.200-172.18.255.250   # must sit inside your kind Docker subnet
# OAUTH2_COOKIE_SECRET=                          # auto-generated (openssl rand) if left unset
