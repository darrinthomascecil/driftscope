# GitHub App auth -> PRIVATE-repo scanning via a KV-signed App JWT (docs/forge-auth.md). The App
# id/installation are shared, non-secret constants; the private key lives in Key Vault as `gh-app-key`
# and is signed INSIDE the vault (KV `sign`) -- it never leaves. driftscope's app identity has Crypto
# User on that vault (terraform: github_app_key_vault_*, app-identity.tf). Only repos the App is
# installed on are reachable; the pod's workload identity reaches the vault cross-vault by token.
DRIFTSCOPE_DEPLOY=cloud
GITHUB_APP_ID=4425305
GITHUB_APP_INSTALLATION_ID=149853299
GITHUB_APP_KEY_VAULT_URI=https://dscopewikv01.vault.azure.net
GITHUB_APP_KEY_NAME=gh-app-key
